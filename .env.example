# Copy values into apps/cms/.env and apps/web/.env as needed.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/qlu_news

# Payload (generate: openssl rand -hex 16)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URLs (local)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
PUBLIC_PAYLOAD_URL=http://localhost:3000
