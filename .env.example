# Copy to repo-root .env for .\dev-remote.cmd (remote Postgres).
# Local Docker Postgres stays in apps/cms/.env for .\dev.cmd
#
# Dedicated Supabase project for QLU News (Payload):
#   Org: Quantum Life University (QLU)
#   Project name: qlu-news
#   Dashboard: https://supabase.com/dashboard/project/<project-ref>
#
# Prefer Session pooler (port 5432) for local Windows / IPv4:
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:[PASSWORD]@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# Local Docker (only if you put it here instead of apps/cms/.env)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/qlu_news

# Payload (generate: openssl rand -hex 16)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URLs (local apps talking to local CMS process)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:4321
PUBLIC_PAYLOAD_URL=http://localhost:3000
