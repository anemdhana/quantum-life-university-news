---
import type { Lang } from '../lib/payload'
import { storyLinkLabel } from '../lib/storyLink'

interface Props {
  href?: string | null
  external?: boolean
  lang: Lang
  class?: string
}

const { href, external = false, lang, class: className } = Astro.props
---

{
  href ? (
    <p class:list={['story-link-wrap', className]}>
      {external ? (
        <a class="story-link" href={href} target="_blank" rel="noopener noreferrer">
          {storyLinkLabel(lang)}
        </a>
      ) : (
        <a class="story-link" href={href}>
          {storyLinkLabel(lang)}
        </a>
      )}
    </p>
  ) : null
}
