---
import type { Lang } from '../lib/payload'
import { storyLinkLabel } from '../lib/storyLink'

interface Props {
  href?: string | null
  external?: boolean
  lang: Lang
  class?: string
  /** When set, news view opens this story in the side drawer instead of navigating. */
  drawerId?: string | null
}

const { href, external = false, lang, class: className, drawerId } = Astro.props
---

{
  href ? (
    <p class:list={['story-link-wrap', className]}>
      {external ? (
        <a class="story-link" href={href} target="_blank" rel="noopener noreferrer">
          {storyLinkLabel(lang)}
        </a>
      ) : (
        <a
          class="story-link"
          href={href}
          {...(drawerId ? { 'data-story-drawer-open': drawerId } : {})}
        >
          {storyLinkLabel(lang)}
        </a>
      )}
    </p>
  ) : null
}
