---
import type { IssueSection, Lang } from '../lib/payload'
import { mdToHtml } from '../lib/markdown'
import { PDF_SECTION_TITLES, isSectionKey } from '../lib/magazineSections'
import { shortItemsForSection } from '../lib/storyLink'
import StoryLink from './StoryLink.astro'

interface Props {
  section: IssueSection
  lang: Lang
  month: string
  from?: 'news' | 'print' | 'flip'
  class?: string
}

const { section, lang, month, from = 'news', class: className } = Astro.props
const asCards = section.key === 'themes' && Boolean(section.asCard)
/** News reader: horizontal image+copy cards; print/flip keep masonry cards. */
const asRows = asCards && from === 'news'
const sectionMeta = isSectionKey(section.key) ? PDF_SECTION_TITLES[section.key] : null
const sectionLabel = sectionMeta
  ? lang === 'te'
    ? sectionMeta.te
    : sectionMeta.en
  : section.key
const sectionNum = sectionMeta?.num || ''
const readMoreLabel = lang === 'te' ? 'పూర్తి కథనం' : 'Full story'
const items = shortItemsForSection(section, lang, month, from).map((item) => {
  const fullText = (item.fullStory || '').trim()
  const blurbText = (item.body || '').trim()
  const showBlurb = Boolean(blurbText) && blurbText !== fullText
  return {
    ...item,
    bodyHtml: mdToHtml(item.body),
    fullStoryHtml: fullText ? mdToHtml(fullText) : '',
    blurbHtml: showBlurb ? mdToHtml(blurbText) : '',
    useDrawer: from === 'news' && Boolean(fullText) && !item.external && Boolean(item.href),
  }
})
---

{
  items.length ? (
    <div
      class:list={[
        'short-items',
        asRows && 'short-items--rows',
        asCards && !asRows && 'short-items--cards',
        className,
      ]}
      {...(asCards && !asRows ? { 'data-card-masonry': true, 'data-masonry-min': '240' } : {})}
    >
      {items.map((item) => (
        <article
          class:list={[
            'short-item',
            asRows && 'short-item--row',
            asCards && !asRows && 'short-item--card',
          ]}
          id={item.anchorId}
        >
          {item.imageSrc ? (
            <figure class="short-item-media">
              <img src={item.imageSrc} alt={item.imageAlt || ''} loading="lazy" />
            </figure>
          ) : null}
          <div class="short-item-copy">
            {item.title ? <h3 class="short-item-title">{item.title}</h3> : null}
            {item.meta ? <p class="short-item-meta">{item.meta}</p> : null}
            {item.bodyHtml ? (
              <div class="short-item-body md-prose" set:html={item.bodyHtml} />
            ) : null}
            <StoryLink
              href={item.href}
              external={item.external}
              lang={lang}
              drawerId={item.useDrawer ? item.anchorId : null}
            />
          </div>
          {item.useDrawer ? (
            <div hidden data-story-source={item.anchorId}>
              <article class="story-reader story-reader--drawer">
                <div class="story-reader__content">
                  {item.imageSrc ? (
                    <figure class="story-reader__hero">
                      <img
                        src={item.imageSrc}
                        alt={item.imageAlt || item.title || ''}
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                  ) : null}
                  <div class="story-reader__copy">
                    <p class="story-reader__kicker">
                      {sectionNum ? `${sectionNum} · ` : ''}
                      {sectionLabel}
                      {' · '}
                      {readMoreLabel}
                    </p>
                    {item.title ? <h1 class="story-reader__title">{item.title}</h1> : null}
                    {item.meta ? <p class="story-reader__meta">{item.meta}</p> : null}
                    {item.blurbHtml ? (
                      <div class="story-reader__lede nr-prose" set:html={item.blurbHtml} />
                    ) : null}
                    {item.fullStoryHtml ? (
                      <div class="story-reader__body nr-prose" set:html={item.fullStoryHtml} />
                    ) : null}
                  </div>
                </div>
              </article>
            </div>
          ) : null}
        </article>
      ))}
    </div>
  ) : null
}
