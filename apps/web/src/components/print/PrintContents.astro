---
import type { Lang } from '../../lib/payload'
import { PDF_CONTENTS_KEYS, PDF_SECTION_TITLES } from '../../lib/magazineSections'
import PrintSheetHeader from './PrintSheetHeader.astro'
import PrintSheetFooter from './PrintSheetFooter.astro'

interface Props {
  lang: Lang
  month: string
  presentKeys: string[]
  page: number
  pages: number
  /** When theme items render as a cards sheet, contents should jump there. */
  themeCardsHref?: string
}

const { lang, month, presentKeys, page, pages, themeCardsHref } = Astro.props
const year = month.slice(0, 4)
const items = PDF_CONTENTS_KEYS.filter((key) => presentKeys.includes(key)).map((key) => {
  const meta = PDF_SECTION_TITLES[key]
  return {
    key,
    num: meta.num,
    title: lang === 'te' ? meta.te : meta.en,
    blurb: lang === 'te' ? meta.blurbTe : meta.blurbEn,
    href: key === 'themes' && themeCardsHref ? themeCardsHref : `#print-${key}-1`,
  }
})
---

<section
  id="print-contents"
  class="print-sheet print-contents"
  aria-label={lang === 'te' ? 'విషయ సూచిక' : 'Contents'}
>
  <PrintSheetHeader
    lang={lang}
    month={month}
    year={year}
    sectionLabel={lang === 'te' ? 'విషయాలు' : 'Contents'}
    variant="contents"
  />

  <div class="print-sheet-body">
    <p class="print-lede">
      {lang === 'te' ? 'ఏడు పునరావృత సంపాదకీయ విభాగాలు' : 'Seven recurring editorial sections'}
    </p>
    <ol class="print-toc">
      {
        items.map((item) => (
          <li>
            <a href={item.href}>
              <span class="print-toc-num">{item.num}</span>
              <span class="print-toc-body">
                <strong>{item.title}</strong>
                {item.blurb ? <span>{item.blurb}</span> : null}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <PrintSheetFooter lang={lang} month={month} page={page} pages={pages} />
</section>
