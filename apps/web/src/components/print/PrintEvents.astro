---
import type { IssueSection, Lang, MediaDoc } from '../../lib/payload'
import { mediaUrl } from '../../lib/payload'
import { itemKeyAt, pickLangText, resolveStoryLink } from '../../lib/storyLink'
import { linesToParagraphs } from '../../lib/printText'
import StoryLink from '../StoryLink.astro'
import PrintFreeform from './PrintFreeform.astro'

interface Props {
  section: IssueSection
  lang: Lang
  month: string
  bodyHtml: string
  emptyLine: string
}

const { section, lang, month, bodyHtml, emptyLine } = Astro.props
const items = (section.eventItems || []).filter(
  (e) =>
    e.when?.trim() ||
    (lang === 'te' ? e.titleTe || e.detailsTe : e.titleEn || e.detailsEn)?.trim(),
)
const hasBody = Boolean(bodyHtml?.replace(/<[^>]+>/g, '').trim())
const ctaLabel = lang === 'te' ? 'మరింత తెలుసుకోండి →' : 'Learn more →'
---

{
  items.length ? (
    <>
      <div class="print-events print-events--cards">
        {items.map((item, i) => {
          const title = (lang === 'te' ? item.titleTe : item.titleEn) || ''
          const venue = (lang === 'te' ? item.venueTe : item.venueEn) || ''
          const details = (lang === 'te' ? item.detailsTe : item.detailsEn) || ''
          const isSpotlight =
            !venue.trim() &&
            /discovery|month of|explore the programme/i.test(title + ' ' + details)
          const imageSrc = mediaUrl(item.image as MediaDoc | number | string | null | undefined)
          const imageAlt =
            (typeof item.image === 'object' && item.image && 'alt' in item.image
              ? item.image.alt
              : '') ||
            title ||
            ''
          const itemKey = itemKeyAt(item.id, i)
          const link = resolveStoryLink({
            month,
            lang,
            sectionKey: 'upcoming',
            itemKey,
            fullStory: pickLangText(lang, item.fullStoryTe, item.fullStoryEn),
            storyUrl: item.storyUrl,
            from: 'print',
          })
          return (
            <article
              class:list={['print-card', 'print-event-card', isSpotlight && 'print-event-card--spotlight']}
              id={link.anchorId}
            >
              {!isSpotlight && imageSrc ? (
                <figure class="print-event-card__media">
                  <img src={imageSrc} alt={imageAlt} loading="lazy" />
                  {item.when ? <span class="print-event-card__when">{item.when}</span> : null}
                </figure>
              ) : null}
              {!isSpotlight && !imageSrc && item.when ? (
                <p class="print-label">{item.when}</p>
              ) : null}
              {venue ? <p class="print-meta-line">{venue}</p> : null}
              {title ? <h3>{title}</h3> : null}
              {linesToParagraphs(details).map((p) =>
                p ? <p>{p}</p> : <p class="print-spacer" aria-hidden="true" />,
              )}
              <StoryLink
                href={link.href}
                external={link.external}
                lang={lang}
                label={ctaLabel}
                class="print-story-link"
              />
            </article>
          )
        })}
      </div>
      {hasBody ? (
        <div class="print-body-follow">
          <PrintFreeform html={bodyHtml} emptyLine={emptyLine} />
        </div>
      ) : null}
    </>
  ) : (
    <PrintFreeform html={bodyHtml} emptyLine={emptyLine} />
  )
}
