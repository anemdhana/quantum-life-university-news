---
import type { IssueSection, Lang } from '../../lib/payload'
import { linesToParagraphs } from '../../lib/printText'
import StoryLink from '../StoryLink.astro'
import PrintFreeform from './PrintFreeform.astro'

interface Props {
  section: IssueSection
  lang: Lang
  bodyHtml: string
  emptyLine: string
}

const { section, lang, bodyHtml, emptyLine } = Astro.props
const items = (section.eventItems || []).filter(
  (e) =>
    e.when?.trim() ||
    (lang === 'te' ? e.titleTe || e.detailsTe : e.titleEn || e.detailsEn)?.trim(),
)
const hasBody = Boolean(bodyHtml?.replace(/<[^>]+>/g, '').trim())
---

{
  items.length ? (
    <>
      <div class="print-events">
        {items.map((item) => {
          const title = (lang === 'te' ? item.titleTe : item.titleEn) || ''
          const venue = (lang === 'te' ? item.venueTe : item.venueEn) || ''
          const details = (lang === 'te' ? item.detailsTe : item.detailsEn) || ''
          return (
            <article class="print-row">
              {item.when ? <p class="print-label">{item.when}</p> : null}
              {title ? <h3>{title}</h3> : null}
              {venue ? <p class="print-meta-line">{venue}</p> : null}
              {linesToParagraphs(details).map((p) =>
                p ? <p>{p}</p> : <p class="print-spacer" aria-hidden="true" />,
              )}
              <StoryLink url={item.storyUrl} lang={lang} class="print-story-link" />
            </article>
          )
        })}
      </div>
      {hasBody ? (
        <div class="print-body-follow">
          <PrintFreeform html={bodyHtml} emptyLine={emptyLine} />
        </div>
      ) : null}
    </>
  ) : (
    <PrintFreeform html={bodyHtml} emptyLine={emptyLine} />
  )
}
