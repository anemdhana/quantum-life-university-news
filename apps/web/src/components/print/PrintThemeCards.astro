---
import type { IssueSection, Lang, MediaDoc } from '../../lib/payload'
import { mediaUrl } from '../../lib/payload'
import { pickLocalized } from '../../lib/localeText'
import { PDF_SECTION_TITLES } from '../../lib/magazineSections'
import {
  htmlToFlowBlocks,
  linesToParagraphs,
  packFlowIntoCards,
  type FlowBlock,
} from '../../lib/printText'
import { normalizeStoryUrl, storyLinkLabel } from '../../lib/storyLink'

interface CardPage {
  section: IssueSection
  bodyHtml: string
}

interface Props {
  cards: CardPage[]
  lang: Lang
  month: string
  year: string
}

const { cards, lang, month, year } = Astro.props
const pdf = PDF_SECTION_TITLES.themes
const sectionLabel = lang === 'te' ? pdf.te : pdf.en

function cardPhoto(section: IssueSection) {
  const row = section.images?.[0]
  if (!row?.image) return null
  const src = mediaUrl(row.image as MediaDoc)
  if (!src) return null
  const caption = pickLocalized(lang, row.captionTe, row.captionEn)
  const alt =
    pickLocalized(lang, row.altTe, row.altEn) ||
    caption ||
    (typeof row.image === 'object' && row.image && 'alt' in row.image ? row.image.alt : '') ||
    ''
  return { src, caption, alt }
}

function buildFlowBlocks(section: IssueSection, bodyHtml: string): FlowBlock[] {
  const blocks: FlowBlock[] = []
  const headline = pickLocalized(lang, section.headingTe, section.headingEn)
  if (headline) blocks.push({ kind: 'title', text: headline })

  const lead = pickLocalized(lang, section.leadTe, section.leadEn)
  for (const line of linesToParagraphs(lead)) {
    if (line.trim()) blocks.push({ kind: 'text', text: line.trim() })
  }

  for (const item of section.themeItems || []) {
    const title = pickLocalized(lang, item.titleTe, item.titleEn)
    const blurb = pickLocalized(lang, item.blurbTe, item.blurbEn)
    if (title) blocks.push({ kind: 'title', text: title })
    for (const line of linesToParagraphs(blurb)) {
      if (line.trim()) blocks.push({ kind: 'text', text: line.trim() })
    }
    const href = normalizeStoryUrl(item.storyUrl)
    if (href) blocks.push({ kind: 'link', href, label: storyLinkLabel(lang) })
  }

  const bodyBlocks = htmlToFlowBlocks(bodyHtml || '')
  if (bodyBlocks.length) {
    blocks.push(...bodyBlocks)
  } else if (bodyHtml?.replace(/<[^>]+>/g, '').trim()) {
    // Fallback: keep whole body HTML if splitter found nothing usable
    blocks.push({
      kind: 'html',
      html: bodyHtml,
      chars: bodyHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().length,
    })
  }

  return blocks
}

type PackedCard = {
  photo: { src: string; alt: string; caption?: string | null } | null
  continued: boolean
  blocks: FlowBlock[]
}

const packedStories = cards.map(({ section, bodyHtml }) => {
  const photo = cardPhoto(section)
  const flow = buildFlowBlocks(section, bodyHtml)
  const columns = packFlowIntoCards(flow, {
    // Comfortable chunks for reading; overflow still continues beside
    firstBudget: photo ? 340 : 460,
    nextBudget: 520,
  })
  const cols = columns.length ? columns : [[]]
  return cols.map((blocks, i) => ({
    photo: i === 0 ? photo : null,
    continued: i > 0,
    blocks,
  })) as PackedCard[]
})

const allCardColumns = packedStories.flat()
---

{
  allCardColumns.length ? (
    <section class="print-sheet print-section print-section--theme-cards" id="print-themes-cards">
      <header class="print-sheet-head">
        <p class="print-sheet-brand">Quantum Life University</p>
        <p class="print-sheet-meta">Monthly / {year}</p>
      </header>
      <p class="print-eyebrow">
        {pdf.num} / {sectionLabel}
      </p>
      <h2 class="print-sheet-title">{sectionLabel}</h2>

      <div class="print-theme-card-grid">
        {allCardColumns.map((col) => (
          <article class="print-theme-card">
            {col.photo ? (
              <figure class="print-theme-card__photo">
                <img src={col.photo.src} alt={col.photo.alt || ''} loading="lazy" />
              </figure>
            ) : null}

            <div class="print-theme-card__body">
              {col.continued ? (
                <p class="print-theme-card__continued">
                  {lang === 'te' ? 'కొనసాగింపు…' : 'Continued…'}
                </p>
              ) : null}

              {col.blocks.length ? (
                col.blocks.map((block) =>
                  block.kind === 'title' ? (
                    <h3 class="print-theme-card__title">{block.text}</h3>
                  ) : block.kind === 'text' ? (
                    <p class="print-theme-card__text">{block.text}</p>
                  ) : block.kind === 'link' ? (
                    <p class="print-theme-card__link story-link-wrap">
                      <a
                        class="story-link print-story-link"
                        href={block.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {block.label}
                      </a>
                    </p>
                  ) : (
                    <div class="print-theme-card__html" set:html={block.html} />
                  ),
                )
              ) : (
                <p class="print-theme-card__empty">
                  {lang === 'te'
                    ? 'ఫోటో కింద కంటెంట్ లేదు — హెడ్‌లైన్ లేదా బాడీ నింపండి.'
                    : 'No text under the photo — add a headline or body on this entry.'}
                </p>
              )}
            </div>
          </article>
        ))}
      </div>

      <footer class="print-sheet-foot">
        <span>Quantum Life University</span>
        <span>{month}</span>
      </footer>
    </section>
  ) : null
}
