---
import type { IssueSection, Lang, MediaDoc } from '../../lib/payload'
import { mediaUrl } from '../../lib/payload'
import { pickLocalized } from '../../lib/localeText'
import { PDF_SECTION_TITLES } from '../../lib/magazineSections'
import { mdToHtml } from '../../lib/markdown'
import {
  itemKeyAt,
  pickLangText,
  resolveStoryLink,
  storyLinkLabel,
} from '../../lib/storyLink'
import PrintSheetHeader from './PrintSheetHeader.astro'
import PrintSheetFooter from './PrintSheetFooter.astro'

interface CardPage {
  section: IssueSection
  bodyHtml: string
}

interface Props {
  cards: CardPage[]
  lang: Lang
  month: string
  year: string
  page: number
  pages: number
}

const { cards, lang, month, year, page, pages } = Astro.props
const pdf = PDF_SECTION_TITLES.themes
const sectionLabel = lang === 'te' ? pdf.te : pdf.en

function cardPhoto(section: IssueSection) {
  const row = section.images?.[0]
  if (!row?.image) return null
  const src = mediaUrl(row.image as MediaDoc)
  if (!src) return null
  const caption = pickLocalized(lang, row.captionTe, row.captionEn)
  const alt =
    pickLocalized(lang, row.altTe, row.altEn) ||
    caption ||
    (typeof row.image === 'object' && row.image && 'alt' in row.image ? row.image.alt : '') ||
    ''
  return { src, caption, alt }
}

type ThemeCard = {
  id?: string
  title: string
  blurbHtml: string
  href: string | null
  external: boolean
  anchorId: string
  label: string
}

type ThemeSheet = {
  headline: string
  leadHtml: string
  photo: { src: string; alt: string; caption?: string | null } | null
  items: ThemeCard[]
  bodyHtml: string
}

const sheets: ThemeSheet[] = cards.map(({ section, bodyHtml }) => {
  const items: ThemeCard[] = (section.themeItems || [])
    .map((item, index) => {
      const title = pickLocalized(lang, item.titleTe, item.titleEn)
      const blurbHtml = mdToHtml(pickLocalized(lang, item.blurbTe, item.blurbEn))
      if (!title && !blurbHtml) return null
      const link = resolveStoryLink({
        month,
        lang,
        sectionKey: 'themes',
        itemKey: itemKeyAt(item.id, index),
        fullStory: pickLangText(lang, item.fullStoryTe, item.fullStoryEn),
        storyUrl: item.storyUrl,
        from: 'print',
      })
      return {
        id: item.id,
        title,
        blurbHtml,
        href: link.href,
        external: link.external,
        anchorId: link.anchorId,
        label: storyLinkLabel(lang),
      }
    })
    .filter(Boolean) as ThemeCard[]

  return {
    headline: pickLocalized(lang, section.headingTe, section.headingEn),
    leadHtml: mdToHtml(pickLocalized(lang, section.leadTe, section.leadEn)),
    photo: cardPhoto(section),
    items,
    bodyHtml: bodyHtml || '',
  }
})

const hasContent = sheets.some(
  (s) =>
    s.headline ||
    s.leadHtml ||
    s.photo ||
    s.items.length ||
    s.bodyHtml.replace(/<[^>]+>/g, '').trim(),
)
---

{
  hasContent ? (
    <section class="print-sheet print-section print-section--theme-cards" id="print-themes-cards">
      <PrintSheetHeader
        lang={lang}
        month={month}
        year={year}
        sectionLabel={sectionLabel}
        sectionNum={pdf.num}
      />

      <div class="print-sheet-body">
        {sheets.map((sheet, sheetIndex) => (
          <div class="print-theme-sheet">
            {sheet.headline ? (
              <h2 class="print-theme-sheet__title print-theme-sheet__title--ribbon">
                <span class="print-theme-sheet__num" aria-hidden="true">
                  {String(sheetIndex + 1).padStart(2, '0')}
                </span>
                <span class="print-theme-sheet__label">{sheet.headline}</span>
              </h2>
            ) : null}

            {sheet.leadHtml ? (
              <div class="print-lead print-theme-sheet__lead">
                <div class="md-prose" set:html={sheet.leadHtml} />
              </div>
            ) : null}

            {sheet.photo ? (
              <figure class="print-theme-sheet__photo">
                <img src={sheet.photo.src} alt={sheet.photo.alt || ''} loading="lazy" />
                {sheet.photo.caption ? <figcaption>{sheet.photo.caption}</figcaption> : null}
              </figure>
            ) : null}

            {sheet.items.length ? (
              <div class="print-theme-card-grid" data-card-masonry data-masonry-min="192">
                {sheet.items.map((item) => (
                  <article class="print-theme-card" id={item.anchorId}>
                    <div class="print-theme-card__body">
                      {item.title ? <h3 class="print-theme-card__title">{item.title}</h3> : null}
                      {item.blurbHtml ? (
                        <div class="print-theme-card__html md-prose" set:html={item.blurbHtml} />
                      ) : (
                        <p class="print-theme-card__empty">
                          {lang === 'te' ? 'బ్లర్బ్ లేదు.' : 'No blurb yet.'}
                        </p>
                      )}
                      {item.href ? (
                        <p class="print-theme-card__link story-link-wrap">
                          {item.external ? (
                            <a
                              class="story-link print-story-link"
                              href={item.href}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {item.label}
                            </a>
                          ) : (
                            <a class="story-link print-story-link" href={item.href}>
                              {item.label}
                            </a>
                          )}
                        </p>
                      ) : null}
                    </div>
                  </article>
                ))}
              </div>
            ) : null}

            {sheet.bodyHtml.replace(/<[^>]+>/g, '').trim() ? (
              <div class="print-theme-sheet__body md-prose" set:html={sheet.bodyHtml} />
            ) : null}
          </div>
        ))}
      </div>

      <PrintSheetFooter lang={lang} month={month} page={page} pages={pages} />
    </section>
  ) : null
}
