---
import type { IssueSection, Lang } from '../../lib/payload'
import { itemKeyAt, pickLangText, resolveStoryLink } from '../../lib/storyLink'
import { linesToParagraphs } from '../../lib/printText'
import StoryLink from '../StoryLink.astro'
import PrintFreeform from './PrintFreeform.astro'

interface Props {
  section: IssueSection
  lang: Lang
  month: string
  bodyHtml: string
  emptyLine: string
}

const { section, lang, month, bodyHtml, emptyLine } = Astro.props
const lead = (lang === 'te' ? section.leadTe : section.leadEn)?.trim() || ''
const items = (section.themeItems || []).filter(
  (t) => (lang === 'te' ? t.titleTe || t.blurbTe : t.titleEn || t.blurbEn)?.trim(),
)
const hasStructured = Boolean(lead || items.length)
const hasBody = Boolean(bodyHtml?.replace(/<[^>]+>/g, '').trim())
---

{
  hasStructured ? (
    <>
      {lead ? (
        <div class="print-lead">
          <p class="print-label">
            {lang === 'te' ? 'సంపాదకీయ లీడ్' : 'Editorial lead'}
          </p>
          {linesToParagraphs(lead).map((p) =>
            p ? <p>{p}</p> : <p class="print-spacer" aria-hidden="true" />,
          )}
        </div>
      ) : null}
      {items.length ? (
        <div class="print-themes">
          <h3 class="print-subhead">{lang === 'te' ? 'ప్రధాన థీమ్స్' : 'Key themes'}</h3>
          <ol class="print-theme-list">
            {items.map((item, i) => {
              const title = (lang === 'te' ? item.titleTe : item.titleEn) || ''
              const blurb = (lang === 'te' ? item.blurbTe : item.blurbEn) || ''
              const blurbLines = linesToParagraphs(blurb)
              const itemKey = itemKeyAt(item.id, i)
              const link = resolveStoryLink({
                month,
                lang,
                sectionKey: 'themes',
                itemKey,
                fullStory: pickLangText(lang, item.fullStoryTe, item.fullStoryEn),
                storyUrl: item.storyUrl,
                from: 'print',
              })
              return (
                <li id={link.anchorId}>
                  <span class="print-item-num">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    {title ? <strong>{title}</strong> : null}
                    {blurbLines.map((p) =>
                      p ? <p>{p}</p> : <p class="print-spacer" aria-hidden="true" />,
                    )}
                    <StoryLink
                      href={link.href}
                      external={link.external}
                      lang={lang}
                      class="print-story-link"
                    />
                  </div>
                </li>
              )
            })}
          </ol>
        </div>
      ) : null}
      {hasBody ? (
        <div class="print-body-follow">
          <PrintFreeform html={bodyHtml} emptyLine={emptyLine} />
        </div>
      ) : null}
    </>
  ) : (
    <PrintFreeform html={bodyHtml} emptyLine={emptyLine} />
  )
}
