---
import type { IssueSection, Lang } from '../../lib/payload'
import { itemKeyAt, pickLangText, resolveStoryLink } from '../../lib/storyLink'
import { linesToParagraphs } from '../../lib/printText'
import StoryLink from '../StoryLink.astro'
import PrintFreeform from './PrintFreeform.astro'

interface Props {
  section: IssueSection
  lang: Lang
  month: string
  bodyHtml: string
  emptyLine: string
}

const { section, lang, month, bodyHtml, emptyLine } = Astro.props
const items = (section.classItems || []).filter(
  (c) => (lang === 'te' ? c.titleTe || c.insightTe : c.titleEn || c.insightEn)?.trim(),
)
const hasBody = Boolean(bodyHtml?.replace(/<[^>]+>/g, '').trim())
---

{
  items.length ? (
    <>
      <div class="print-classes">
        {items.map((item, i) => {
          const title = (lang === 'te' ? item.titleTe : item.titleEn) || ''
          const insight = (lang === 'te' ? item.insightTe : item.insightEn) || ''
          const meta = [item.speaker, item.date].filter(Boolean).join(' · ')
          const itemKey = itemKeyAt(item.id, i)
          const link = resolveStoryLink({
            month,
            lang,
            sectionKey: 'highlight-classes',
            itemKey,
            fullStory: pickLangText(lang, item.fullStoryTe, item.fullStoryEn),
            storyUrl: item.storyUrl,
            from: 'print',
          })
          return (
            <article class="print-card" id={link.anchorId}>
              <p class="print-label">
                {(lang === 'te' ? 'హైలైట్ క్లాస్' : 'Featured class') +
                  ' ' +
                  String(i + 1).padStart(2, '0')}
              </p>
              {title ? <h3>{title}</h3> : null}
              {meta ? <p class="print-meta-line">{meta}</p> : null}
              {linesToParagraphs(insight).map((p) =>
                p ? <p>{p}</p> : <p class="print-spacer" aria-hidden="true" />,
              )}
              <StoryLink
                href={link.href}
                external={link.external}
                lang={lang}
                class="print-story-link"
              />
            </article>
          )
        })}
      </div>
      {hasBody ? (
        <div class="print-body-follow">
          <PrintFreeform html={bodyHtml} emptyLine={emptyLine} />
        </div>
      ) : null}
    </>
  ) : (
    <PrintFreeform html={bodyHtml} emptyLine={emptyLine} />
  )
}
