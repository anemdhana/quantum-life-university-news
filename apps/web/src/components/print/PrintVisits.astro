---
import type { IssueSection, Lang } from '../../lib/payload'
import { linesToParagraphs } from '../../lib/printText'
import PrintFreeform from './PrintFreeform.astro'

interface Props {
  section: IssueSection
  lang: Lang
  bodyHtml: string
  emptyLine: string
}

const { section, lang, bodyHtml, emptyLine } = Astro.props
const items = (section.visitItems || []).filter(
  (v) => v.date?.trim() || v.place?.trim() || (lang === 'te' ? v.noteTe : v.noteEn)?.trim(),
)
const hasBody = Boolean(bodyHtml?.replace(/<[^>]+>/g, '').trim())
---

{
  items.length ? (
    <>
      <div class="print-visits">
        {items.map((item) => {
          const note = (lang === 'te' ? item.noteTe : item.noteEn) || ''
          const head = [item.date, item.place].filter(Boolean).join(' / ')
          return (
            <article class="print-row">
              {head ? <h3 class="print-row-head">{head}</h3> : null}
              {linesToParagraphs(note).map((p) =>
                p ? <p>{p}</p> : <p class="print-spacer" aria-hidden="true" />,
              )}
            </article>
          )
        })}
      </div>
      {hasBody ? (
        <div class="print-body-follow">
          <PrintFreeform html={bodyHtml} emptyLine={emptyLine} />
        </div>
      ) : null}
    </>
  ) : (
    <PrintFreeform html={bodyHtml} emptyLine={emptyLine} />
  )
}
