---
import type { IssueSection, Lang, MediaDoc } from '../../lib/payload'
import { mediaUrl } from '../../lib/payload'
import { itemKeyAt, pickLangText, resolveStoryLink } from '../../lib/storyLink'
import { linesToParagraphs } from '../../lib/printText'
import StoryLink from '../StoryLink.astro'
import PrintFreeform from './PrintFreeform.astro'

interface Props {
  section: IssueSection
  lang: Lang
  month: string
  bodyHtml: string
  emptyLine: string
}

const { section, lang, month, bodyHtml, emptyLine } = Astro.props
const items = (section.visitItems || []).filter(
  (v) =>
    v.date?.trim() ||
    v.place?.trim() ||
    v.titleTe?.trim() ||
    v.titleEn?.trim() ||
    (lang === 'te' ? v.noteTe : v.noteEn)?.trim(),
)
const hasBody = Boolean(bodyHtml?.replace(/<[^>]+>/g, '').trim())
---

{
  items.length ? (
    <>
      <div class="print-classes">
        {items.map((item, i) => {
          const storyTitle = pickLangText(lang, item.titleTe, item.titleEn)
          const where = [item.date, item.place].filter(Boolean).join(' · ')
          const title = storyTitle || where || [item.date, item.place].filter(Boolean).join(' / ')
          const note = pickLangText(lang, item.noteTe, item.noteEn)
          const meta = [item.byline, where].filter(Boolean).join(' · ')
          const day = (item.date || '').trim()
          const imageSrc = mediaUrl(item.image as MediaDoc | number | string | null | undefined)
          const imageAlt =
            (typeof item.image === 'object' && item.image && 'alt' in item.image
              ? item.image.alt
              : '') ||
            title ||
            ''
          const itemKey = itemKeyAt(item.id, i)
          const link = resolveStoryLink({
            month,
            lang,
            sectionKey: 'visits',
            itemKey,
            fullStory: pickLangText(lang, item.fullStoryTe, item.fullStoryEn),
            storyUrl: item.storyUrl,
            from: 'print',
          })
          return (
            <article class="print-card print-class-card" id={link.anchorId}>
              {imageSrc ? (
                <figure class="print-class-card__media">
                  <img src={imageSrc} alt={imageAlt} loading="lazy" />
                  {day ? <span class="print-class-card__day">{day}</span> : null}
                </figure>
              ) : day ? (
                <p class="print-label">{day}</p>
              ) : (
                <p class="print-label">
                  {(lang === 'te' ? 'యాత్ర' : 'Travelogue') +
                    ' ' +
                    String(i + 1).padStart(2, '0')}
                </p>
              )}
              {title ? <h3>{title}</h3> : null}
              {meta ? <p class="print-meta-line">{meta}</p> : null}
              {linesToParagraphs(note).map((p) =>
                p ? <p>{p}</p> : <p class="print-spacer" aria-hidden="true" />,
              )}
              <StoryLink
                href={link.href}
                external={link.external}
                lang={lang}
                class="print-story-link"
              />
            </article>
          )
        })}
      </div>
      {hasBody ? (
        <div class="print-body-follow">
          <PrintFreeform html={bodyHtml} emptyLine={emptyLine} />
        </div>
      ) : null}
    </>
  ) : (
    <PrintFreeform html={bodyHtml} emptyLine={emptyLine} />
  )
}
