---
import type { Issue, IssueSection, Lang, MediaDoc } from '../../lib/payload'
import { mediaUrl } from '../../lib/payload'
import { EMPTY_SECTION } from '../../lib/magazineSections'
import { qluIssueStamp } from '../../lib/printBrand'
import ShortItems from '../ShortItems.astro'

type Chapter = {
  id: string
  key: string
  num: string
  sectionTitle: string
  heading: string
  blurb: string
  bodyHtml: string
  emptyBody: boolean
  hasShortItems: boolean
  images: { src: string; caption?: string | null; alt: string }[]
  section: IssueSection
}

interface Props {
  issue: Issue
  lang: Lang
  title: string
  mastheadHtml: string
  chapters: Chapter[]
  toc: { id: string; num: string; label: string }[]
  newsHrefTe: string
  newsHrefEn: string
  flipHref: string
  printHref: string
}

const {
  issue,
  lang,
  title,
  mastheadHtml,
  chapters,
  toc,
  newsHrefTe,
  newsHrefEn,
  flipHref,
  printHref,
} = Astro.props

const coverSrc = mediaUrl(issue.coverImage as MediaDoc)
const tagline =
  (lang === 'te' ? issue.taglineTe : issue.taglineEn)?.trim() ||
  (lang === 'te'
    ? 'ధ్యానం • ఆత్మజ్ఞానం • చైతన్య వికాసం'
    : 'Meditation • Self-knowledge • Expansion of Consciousness')
const monthLabel = qluIssueStamp(issue.month, lang)
const coverLabel = lang === 'te' ? 'ముఖచిత్రం' : 'Cover'
const sectionSelectLabel = lang === 'te' ? 'విభాగం' : 'Section'
const viewingLabel = lang === 'te' ? 'చూస్తున్నది' : 'Viewing'
const emptyLine = lang === 'te' ? EMPTY_SECTION.te : EMPTY_SECTION.en
const newsHref = lang === 'te' ? newsHrefTe : newsHrefEn
const drawerCloseLabel = lang === 'te' ? 'మూసివేయి' : 'Close'
const drawerBackLabel = lang === 'te' ? '← తిరిగి' : '← Back'
const drawerTitle = lang === 'te' ? 'పూర్తి కథనం' : 'Full story'
---

<div class="nr" data-newsview>
  <header class="nr__chrome">
    <div class="nr__chrome-left">
      <a class="nr__chrome-brand" href="/">
        <img src="/qlu-logo.png" width="28" height="28" alt="" />
        <span class="nr__chrome-brand-text">QLU</span>
      </a>
      <div class="nr__chrome-issue">
        <span class="nr__chrome-month">{monthLabel}</span>
        <span class="nr__chrome-dot" aria-hidden="true">·</span>
        <span class="nr__chrome-title">{title}</span>
      </div>
    </div>

    <div class="nr__chrome-center">
      <span class="nr__chrome-viewing-label">{viewingLabel}</span>
      <span class="nr__chrome-viewing" data-news-heading>{coverLabel}</span>
      <label class="visually-hidden" for="nr-section-select-chrome">{sectionSelectLabel}</label>
      <select
        id="nr-section-select-chrome"
        class="nr__chrome-select"
        data-news-section-select
        aria-label={lang === 'te' ? 'విభాగం ఎంచుకోండి' : 'Choose section'}
      >
        {
          toc.map((item) => (
            <option value={item.id}>
              {item.num}. {item.label}
            </option>
          ))
        }
      </select>
    </div>

    <div class="nr__chrome-right">
      <div class="nr__lang nr__lang--bar" role="navigation" aria-label="Language">
        <a class:list={{ active: lang === 'te' }} href={newsHrefTe}>TE</a>
        <a class:list={{ active: lang === 'en' }} href={newsHrefEn}>EN</a>
      </div>
      <nav class="nr__chrome-views" aria-label={lang === 'te' ? 'లేఅవుట్' : 'Layout'}>
        <a class="is-active" href={newsHref} aria-current="page">
          {lang === 'te' ? 'న్యూస్' : 'News'}
        </a>
        <a href={flipHref}>{lang === 'te' ? 'ఫ్లిప్' : 'Flip'}</a>
        <a href={printHref}>{lang === 'te' ? 'ప్రింట్' : 'Print'}</a>
      </nav>
      <a class="nr__issues" href="/issues/">
        {lang === 'te' ? 'సంచికలు' : 'Issues'}
      </a>
    </div>
  </header>

  <div class="nr__main">
    <div class="nr__progress" aria-hidden="true">
      <div class="nr__progress-bar" data-news-progress />
    </div>

    <div class="nr__scroll">
      <section class="nr__cover" id="nr-cover" data-news-section data-news-label={coverLabel}>
        <div class="nr__cover-media">
          {
            coverSrc ? (
              <img src={coverSrc} alt="" loading="eager" decoding="async" />
            ) : (
              <div class="nr__cover-fallback" />
            )
          }
          <div class="nr__cover-shade" />
        </div>
        <div class="nr__cover-copy">
          <p class="nr__kicker">{lang === 'te' ? 'నెలవారీ పత్రిక' : 'Monthly newsletter'}</p>
          <p class="nr__cover-month">{monthLabel}</p>
          <h2 class="nr__cover-title">{title}</h2>
          <p class="nr__cover-tag">{tagline}</p>
          {
            mastheadHtml ? (
              <div class="nr__cover-lede nr-prose" set:html={mastheadHtml} />
            ) : null
          }
          {
            toc.length > 1 ? (
              <a class="nr__begin" href={`#${toc[1]!.id}`}>
                {lang === 'te' ? 'చదవడం ప్రారంభించండి →' : 'Begin reading →'}
              </a>
            ) : null
          }
        </div>
      </section>

      <div class="nr__river">
        {
          chapters.map((ch, i) => {
            const lead = ch.images[0] || null
            const rest = ch.images.slice(1)
            const themeCards = ch.key === 'themes' && Boolean(ch.section.asCard)
            const lineTitle = ch.heading || ch.sectionTitle
            const isEmpty = ch.emptyBody && !ch.hasShortItems && ch.images.length === 0
            return (
              <article
                class:list={['nr-chapter', i % 2 === 1 && 'nr-chapter--alt']}
                id={ch.id}
                data-news-section
                data-news-label={lineTitle}
              >
                <header class="nr-chapter__head">
                  <div class="nr-chapter__sticky">
                    <span class="nr-chapter__num">{ch.num}</span>
                    <h2 class="nr-chapter__title">{lineTitle}</h2>
                  </div>
                </header>

                <div class="nr-chapter__content">
                  {lead ? (
                    <figure class="nr-chapter__hero">
                      <img src={lead.src} alt={lead.alt || ''} loading="lazy" />
                      {lead.caption ? <figcaption>{lead.caption}</figcaption> : null}
                    </figure>
                  ) : null}

                  <div class="nr-chapter__body">
                    {isEmpty ? <p class="nr-empty">{emptyLine}</p> : null}

                    {!ch.emptyBody ? <div class="nr-prose" set:html={ch.bodyHtml} /> : null}

                    {ch.hasShortItems ? (
                      <div
                        class:list={[
                          'nr-chapter__items',
                          themeCards && 'nr-chapter__items--themes',
                        ]}
                      >
                        <ShortItems
                          section={ch.section}
                          lang={lang}
                          month={issue.month}
                          from="news"
                        />
                      </div>
                    ) : null}

                    {rest.length ? (
                      <div class="nr-gallery">
                        {rest.map((img) => (
                          <figure>
                            <img src={img.src} alt={img.alt || ''} loading="lazy" />
                            {img.caption ? <figcaption>{img.caption}</figcaption> : null}
                          </figure>
                        ))}
                      </div>
                    ) : null}
                  </div>
                </div>
              </article>
            )
          })
        }
      </div>

      <footer class="nr__foot">
        <p>© {new Date().getFullYear()} Quantum Life University</p>
        <p>
          <a href="/issues/">{lang === 'te' ? 'అన్ని సంచికలు' : 'All issues'}</a>
          {' · '}
          <a href="https://qluglobal.org/" target="_blank" rel="noopener noreferrer">
            qluglobal.org
          </a>
        </p>
      </footer>
    </div>
  </div>

  <div class="nr-drawer" data-story-drawer aria-hidden="true">
    <button
      type="button"
      class="nr-drawer__scrim"
      data-story-drawer-close
      tabindex="-1"
      aria-label={drawerCloseLabel}
    />
    <aside
      class="nr-drawer__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="nr-drawer-heading"
    >
      <header class="nr-drawer__bar">
        <button type="button" class="nr-drawer__back" data-story-drawer-close>
          {drawerBackLabel}
        </button>
        <span class="nr-drawer__heading" id="nr-drawer-heading">{drawerTitle}</span>
        <button
          type="button"
          class="nr-drawer__x"
          data-story-drawer-close
          aria-label={drawerCloseLabel}
        >
          ×
        </button>
      </header>
      <div class="nr-drawer__scroll" data-story-drawer-mount></div>
    </aside>
  </div>
</div>
