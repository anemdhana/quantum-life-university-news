---
export const prerender = false

import BaseLayout from '../../../../layouts/BaseLayout.astro'
import { htmlToChapters } from '../../../../lib/chapters'
import { getReading, listReadings, type Lang } from '../../../../lib/payload'

const { series, day: dayParam, lang: langParam } = Astro.params
const day = Number(dayParam)
const lang = (langParam === 'te' ? 'te' : 'en') as Lang

if (!Number.isFinite(day) || day < 1) {
  return new Response(null, { status: 404 })
}
if (langParam !== 'te' && langParam !== 'en') {
  return Astro.redirect(`/jnanodayam/${series}/${day}/en/`)
}

let reading: Awaited<ReturnType<typeof getReading>> = null
let all: Awaited<ReturnType<typeof listReadings>> = []
let error = ''
try {
  ;[reading, all] = await Promise.all([getReading(series!, day), listReadings(series)])
} catch (e) {
  error = e instanceof Error ? e.message : 'CMS error'
}

if (!error && !reading) {
  return new Response(null, { status: 404 })
}

const SERIES_META: Record<string, { title: string; titleTe: string }> = {
  'devi-navaratri': {
    title: 'Devi Navaratrula Jnanam',
    titleTe: 'దేవీ నవరాత్రుల జ్ఞానం',
  },
}

const seriesMeta = SERIES_META[series || ''] || {
  title: series || 'Programme',
  titleTe: '',
}

const title = reading
  ? lang === 'te'
    ? reading.titleTe
    : reading.titleEn
  : `Day ${day}`
const subtitle = reading
  ? lang === 'te'
    ? reading.subtitleTe || reading.subtitleEn
    : reading.subtitleEn || reading.subtitleTe
  : ''
const body = reading
  ? lang === 'te'
    ? reading.bodyHtmlTe
    : reading.bodyHtmlEn
  : ''

const chapters = htmlToChapters(body)
const prev = all.find((r) => r.day === day - 1)
const next = all.find((r) => r.day === day + 1)
const totalMinutes = chapters.reduce((sum, c) => sum + c.minutes, 0)
const chaptersJson = JSON.stringify(chapters).replace(/</g, '\\u003c')
---

<BaseLayout
  title={`${title} · Jnanodayam`}
  description={subtitle || title}
  lang={lang}
  variant="landing"
  mainClass="jnana-reader-main"
>
  {
    error ? (
      <p class="qlu-error" style="padding: 1.5rem">
        {error}
      </p>
    ) : reading ? (
      <div class="jnana-r" data-jnana-reader>
        <script type="application/json" data-jnana-chapters set:html={chaptersJson} />
        <aside class="jnana-r__side">
          <a class="jnana-r__brand" href="/">
            <img src="/qlu-logo.png" width="28" height="28" alt="" />
            <span>Quantum Life University</span>
          </a>
          <nav class="jnana-r__day-jump" aria-label="Day navigation">
            <a href={`/jnanodayam/${series}/`}>Days</a>
            {prev ? (
              <a href={`/jnanodayam/${series}/${prev.day}/${lang}/`}>← {prev.day}</a>
            ) : null}
            {next ? (
              <a href={`/jnanodayam/${series}/${next.day}/${lang}/`}>{next.day} →</a>
            ) : null}
          </nav>
          <h1 class="jnana-r__series">{seriesMeta.title}</h1>
          {seriesMeta.titleTe ? (
            <p class="jnana-r__series-te" lang="te">
              {seriesMeta.titleTe}
            </p>
          ) : null}
          <p class="jnana-r__sub">
            Day {reading.day}
            {subtitle ? ` · ${subtitle}` : ''}
            {totalMinutes ? ` · ~${totalMinutes} min` : ''}
          </p>
          <ul class="jnana-r__nav" data-jnana-nav aria-label="Sections" />
        </aside>

        <div class="jnana-r__main">
          <header class="jnana-r__bar">
            <div class="jnana-r__bar-left">
              <button
                type="button"
                class="jnana-r__icon-btn jnana-r__menu"
                data-jnana-menu
                aria-expanded="false"
                aria-controls="jnana-mobile-side"
                aria-label="Sections"
              >
                ☰
              </button>
              <span class="jnana-r__heading" data-jnana-heading>
                {chapters[0]?.title || title}
              </span>
            </div>
            <div class="jnana-r__tools">
              <div class="jnana-r__lang" role="navigation" aria-label="Language">
                <a
                  class:list={{ 'is-active': lang === 'te' }}
                  href={`/jnanodayam/${series}/${day}/te/`}
                >
                  TE
                </a>
                <a
                  class:list={{ 'is-active': lang === 'en' }}
                  href={`/jnanodayam/${series}/${day}/en/`}
                >
                  EN
                </a>
              </div>
              <span class="jnana-r__time" data-jnana-time />
              <button
                type="button"
                class="jnana-r__icon-btn"
                data-jnana-font
                title="Toggle text size"
              >
                A±
              </button>
            </div>
          </header>

          <div class="jnana-r__progress-track" aria-hidden="true">
            <div class="jnana-r__progress" data-jnana-progress />
          </div>

          <div class="jnana-r__reader">
            <div class="jnana-r__spread">
              <div class="jnana-r__columns" data-jnana-columns />
            </div>
            <footer class="jnana-r__bottom">
              <button type="button" data-jnana-prev>
                ← Previous
              </button>
              <span data-jnana-position />
              <button type="button" data-jnana-next>
                Next →
              </button>
            </footer>
          </div>

          {
            next ? (
              <a
                class="jnana-r__end-link"
                data-jnana-end-link
                href={`/jnanodayam/${series}/${next.day}/${lang}/`}
              >
                Continue to Day {next.day}
              </a>
            ) : (
              <a
                class="jnana-r__end-link"
                data-jnana-end-link
                href={`/jnanodayam/${series}/`}
              >
                Back to day list
              </a>
            )
          }
        </div>

        <div
          class="jnana-r__mobile-side"
          id="jnana-mobile-side"
          data-jnana-mobile-side
        >
          <nav class="jnana-r__day-jump" aria-label="Day navigation">
            <a href={`/jnanodayam/${series}/`}>Days</a>
            {prev ? (
              <a href={`/jnanodayam/${series}/${prev.day}/${lang}/`}>← {prev.day}</a>
            ) : null}
            {next ? (
              <a href={`/jnanodayam/${series}/${next.day}/${lang}/`}>{next.day} →</a>
            ) : null}
          </nav>
          <ul class="jnana-r__nav" data-jnana-mobile-nav aria-label="Sections" />
        </div>
      </div>
    ) : null
  }
</BaseLayout>

<script>
  import { initJnanaReader } from '../../../../scripts/jnanaReader'

  document.querySelectorAll<HTMLElement>('[data-jnana-reader]').forEach((el) => {
    initJnanaReader(el)
  })
</script>
