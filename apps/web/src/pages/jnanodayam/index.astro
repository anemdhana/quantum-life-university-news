---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { listReadings, mediaUrl, type MediaDoc } from '../../lib/payload'

let error = ''
let deviReadings: Awaited<ReturnType<typeof listReadings>> = []
let daily: Awaited<ReturnType<typeof listReadings>> = []
try {
  ;[deviReadings, daily] = await Promise.all([
    listReadings('devi-navaratri'),
    listReadings('daily'),
  ])
} catch (e) {
  error = e instanceof Error ? e.message : 'CMS error'
}

// Newest class first on the hub
const dailySorted = [...daily].sort((a, b) => (b.day || 0) - (a.day || 0))

const programmes = [
  {
    key: 'devi-navaratri',
    href: '/jnanodayam/devi-navaratri/',
    kicker: 'Reading series',
    title: 'Devi Navaratrula Jnanam',
    titleTe: 'దేవీ నవరాత్రుల జ్ఞానం',
    body:
      deviReadings.length > 0
        ? `${deviReadings.length} days · Telugu & English`
        : 'Self-knowledge readings from the morning discourses.',
    cta: 'Open days →',
    live: true,
    cover: deviReadings.map((r) => mediaUrl(r.cover as MediaDoc)).find(Boolean) || null,
  },
]

const availableCount = programmes.filter((p) => p.live).length + dailySorted.length
---

<BaseLayout
  title="Jnanodayam · Quantum Life University"
  description="QLU Jnanodayam reading programmes — Telugu & English"
  variant="landing"
  mainClass="home-main archive-main"
>
  <header class="archive-hero">
    <div class="archive-hero__glow" aria-hidden="true" />
    <div class="archive-hero__motif" aria-hidden="true" />
    <div class="archive-hero__inner">
      <div class="archive-top">
        <a class="archive-brand" href="/" aria-label="Quantum Life University home">
          <img class="archive-brand__mark" src="/qlu-logo.png" width="40" height="40" alt="" />
          <span>Quantum Life University</span>
        </a>
        <a class="archive-back" href="/">Home</a>
      </div>
      <h1 class="archive-title">Jnanodayam</h1>
      <p class="archive-lede" lang="te">జ్ఞానోదయం</p>
      <p class="archive-lede archive-lede--follow">
        Self-knowledge reading programmes · Telugu &amp; English.
      </p>
    </div>
  </header>

  <section class="archive-body" aria-labelledby="jnana-list-title">
    {error ? <p class="qlu-error">{error}</p> : null}

    <div class="archive-body__head">
      <h2 id="jnana-list-title">Programmes</h2>
      <p>{availableCount} available</p>
    </div>

    <div class="jnana-tiles">
      {
        programmes.map((prog, i) =>
          prog.live ? (
            <a
              class="jnana-tile jnana-tile--feature"
              href={prog.href}
              style={`--tile-i: ${i}`}
            >
              <span class="jnana-tile__media">
                {prog.cover ? (
                  <img src={prog.cover} alt="" loading="eager" />
                ) : (
                  <span class="jnana-tile__fallback" aria-hidden="true" />
                )}
                <span class="jnana-tile__shade" aria-hidden="true" />
              </span>
              <span class="jnana-tile__copy">
                <span class="jnana-tile__kicker">{prog.kicker}</span>
                <span class="jnana-tile__title">{prog.title}</span>
                <span class="jnana-tile__title-te" lang="te">
                  {prog.titleTe}
                </span>
                <span class="jnana-tile__body">{prog.body}</span>
                <span class="jnana-tile__cta">{prog.cta}</span>
              </span>
            </a>
          ) : null,
        )
      }
    </div>

    {
      dailySorted.length ? (
        <div class="archive-body__head" style="margin-top: 2rem">
          <h2 id="jnana-classes-title">Highlight classes</h2>
          <p>{dailySorted.length} published</p>
        </div>
      ) : null
    }

    {
      dailySorted.length ? (
        <div class="jnana-day-grid" aria-labelledby="jnana-classes-title">
          {dailySorted.map((r, i) => {
            const dayCover = mediaUrl(r.cover as MediaDoc)
            return (
              <article class="jnana-day" style={`--card-i: ${i}`}>
                <a class="jnana-day__main" href={`/jnanodayam/daily/${r.day}/te/`}>
                  <span class="jnana-day__media">
                    {dayCover ? (
                      <img src={dayCover} alt="" loading="lazy" />
                    ) : (
                      <span class="jnana-day__fallback" aria-hidden="true" />
                    )}
                    <span class="jnana-day__day">Day {r.day}</span>
                  </span>
                  <span class="jnana-day__body">
                    <strong class="jnana-day__title">
                      {r.subtitleEn || r.titleEn}
                    </strong>
                    {(() => {
                      const en = (r.subtitleEn || r.titleEn || '').trim()
                      const te = (r.subtitleTe || r.titleTe || '').trim()
                      return te && te !== en ? (
                        <span class="jnana-day__title-te" lang="te">
                          {te}
                        </span>
                      ) : null
                    })()}
                  </span>
                </a>
                <div class="jnana-day__langs">
                  <a href={`/jnanodayam/daily/${r.day}/te/`}>తెలుగు</a>
                  <a href={`/jnanodayam/daily/${r.day}/en/`}>English</a>
                </div>
              </article>
            )
          })}
        </div>
      ) : null
    }

    {
      !dailySorted.length ? (
        <aside class="archive-soon" aria-label="Coming soon">
          <p class="archive-soon__label">More programmes</p>
          <p class="archive-soon__hint">
            New Jnanodayam series and classes will appear here when published.
          </p>
        </aside>
      ) : null
    }
  </section>

  <footer class="home-foot">
    <a href="/">Home</a>
    <span aria-hidden="true">·</span>
    <a href="/issues/">Newsletter</a>
    <span aria-hidden="true">·</span>
    <a href="https://qluglobal.org/" target="_blank" rel="noopener noreferrer">
      qluglobal.org
    </a>
  </footer>
</BaseLayout>
