---
export const prerender = false

import BaseLayout from '../../../layouts/BaseLayout.astro'
import PrintCover from '../../../components/print/PrintCover.astro'
import PrintContents from '../../../components/print/PrintContents.astro'
import PrintSection from '../../../components/print/PrintSection.astro'
import PrintThemeCards from '../../../components/print/PrintThemeCards.astro'
import ShortItems from '../../../components/ShortItems.astro'
import NewsRiver from '../../../components/news/NewsRiver.astro'
import BirthdaySplash from '../../../components/BirthdaySplash.astro'
import {
  getIssue,
  mediaUrl,
  type IssueSection,
  type Lang,
  type MediaDoc,
} from '../../../lib/payload'
import { PDF_CONTENTS_KEYS, PDF_SECTION_TITLES } from '../../../lib/magazineSections'
import { pickLocalized, pickLocalizedLexical } from '../../../lib/localeText'
import { isLexicalEmpty, lexicalToHtml, lexicalToPlain } from '../../../lib/richText'
import { shortItemsForSection } from '../../../lib/storyLink'

const { month, lang: langParam } = Astro.params
const lang = (langParam === 'te' ? 'te' : 'en') as Lang

if (langParam !== 'te' && langParam !== 'en') {
  return Astro.redirect(`/issues/${month}/en/`)
}

const viewParam = Astro.url.searchParams.get('view')
const view = viewParam === 'print' ? 'print' : viewParam === 'flip' ? 'flip' : 'news'

let issue: Awaited<ReturnType<typeof getIssue>> = null
let error = ''
try {
  issue = await getIssue(month!)
} catch (e) {
  error = e instanceof Error ? e.message : 'CMS error'
}

if (!error && !issue) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const title = issue ? (lang === 'te' ? issue.titleTe : issue.titleEn) : month!
const other = lang === 'te' ? 'en' : 'te'

const CHIP_LABELS: Record<string, { te: string; en: string }> = {
  masthead: { te: 'ముఖం', en: 'Cover' },
  themes: { te: 'థీమ్', en: 'Themes' },
  'highlight-classes': { te: 'క్లాస్', en: 'Classes' },
  experiences: { te: 'అనుభవం', en: 'Stories' },
  visits: { te: 'పర్యటన', en: 'Visits' },
  vanya: { te: 'వన్య', en: 'Vanya' },
  campus: { te: 'క్యాంపస్', en: 'Campus' },
  upcoming: { te: 'రాబోయేవి', en: 'Next' },
  closing: { te: 'ముగింపు', en: 'Close' },
}

const flipHref = `/issues/${month}/${lang}/?view=flip`
const newsHref = `/issues/${month}/${lang}/?view=news`
const printHref = `/issues/${month}/${lang}/?view=print`
const flipHrefOther = `/issues/${month}/${other}/?view=flip`
const newsHrefOther = `/issues/${month}/${other}/?view=news`
const flipHrefTe = `/issues/${month}/te/?view=flip`
const flipHrefEn = `/issues/${month}/en/?view=flip`
const newsHrefTe = `/issues/${month}/te/?view=news`
const newsHrefEn = `/issues/${month}/en/?view=news`
const printHrefTe = `/issues/${month}/te/?view=print`
const printHrefEn = `/issues/${month}/en/?view=print`
const labelFlip = lang === 'te' ? 'ఫ్లిప్‌బుక్' : 'Flipbook'
const labelNews = lang === 'te' ? 'న్యూస్ వ్యూ' : 'News view'
const labelPrint = lang === 'te' ? 'ప్రింట్' : 'Print'
const labelLayout = lang === 'te' ? 'లేఅవుట్' : 'Layout'

function mapSectionPage(section: IssueSection, i: number) {
  const heading = pickLocalized(lang, section.headingTe, section.headingEn)
  const bodyData = pickLocalizedLexical(lang, section.bodyTe, section.bodyEn)
  const bodyHtml = lexicalToHtml(bodyData)
  const teaser = lexicalToPlain(bodyData, 140)
  const emptyBody = isLexicalEmpty(bodyData)
  /** Only the masthead section is the cover — never fall back to index 0 */
  const isCover = section.key === 'masthead'
  const chip = CHIP_LABELS[section.key]
  const images =
    section.images
      ?.map((row) => {
        const src = mediaUrl(row.image as MediaDoc)
        if (!src) return null
        const caption = lang === 'te' ? row.captionTe : row.captionEn
        const alt =
          (lang === 'te' ? row.altTe : row.altEn) ||
          caption ||
          (typeof row.image === 'object' && row.image && 'alt' in row.image
            ? row.image.alt
            : '') ||
          ''
        return {
          src,
          caption,
          alt,
          align: row.align || 'center',
          size: row.size || 'md',
        }
      })
      .filter(Boolean) || []
  const hero = images[0] || null
  const pdfTitle = PDF_SECTION_TITLES[section.key as keyof typeof PDF_SECTION_TITLES]
  const shortItems = shortItemsForSection(section, lang, month!)
  const hasShortItems = shortItems.length > 0
  return {
    section,
    heading,
    bodyHtml,
    teaser,
    emptyBody,
    hasShortItems,
    isCover,
    images,
    hero,
    pageLabel: isCover
      ? lang === 'te'
        ? 'ముఖచిత్రం'
        : 'Cover'
      : heading || (pdfTitle ? (lang === 'te' ? pdfTitle.te : pdfTitle.en) : section.key),
    chipLabel: chip ? chip[lang] : String(i + 1),
    isUpcoming: section.key === 'upcoming',
  }
}

const allSections = issue?.sections || []
const mastheadSection = allSections.find((s) => s.key === 'masthead')
const closingSection = [...allSections].reverse().find((s) => s.key === 'closing')

/** Main newsletter sections — multiple entries per key are kept in order. */
const emptySectionStub = (key: (typeof PDF_CONTENTS_KEYS)[number]): IssueSection => ({
  key,
  headingTe: null,
  headingEn: null,
  bodyTe: null,
  bodyEn: null,
  images: [],
})

const ensuredMainSections: IssueSection[] = PDF_CONTENTS_KEYS.flatMap((key) => {
  const matches = allSections.filter((s) => s.key === key)
  return matches.length ? matches : [emptySectionStub(key)]
})

const pages = [
  ...(mastheadSection ? [mapSectionPage(mastheadSection, 0)] : []),
  ...ensuredMainSections.map((s, i) => mapSectionPage(s, i + 1)),
  ...(closingSection ? [mapSectionPage(closingSection, ensuredMainSections.length + 1)] : []),
]

const cover = pages.find((p) => p.isCover) || null

const printSections = ensuredMainSections.map((s, i) => mapSectionPage(s, i))
const printThemeCards = printSections.filter(
  (page) => page.section.key === 'themes' && Boolean(page.section.asCard),
)
const printSectionsNormal = printSections.filter(
  (page) => !(page.section.key === 'themes' && Boolean(page.section.asCard)),
)
const printPresentKeys = [...PDF_CONTENTS_KEYS]
const mastheadHtml = cover && !cover.emptyBody ? cover.bodyHtml : ''
const printYear = (issue?.month || month || '').slice(0, 4)
/** Cover + Contents + optional theme-cards sheet + interior sections */
const printHasThemeCards = printThemeCards.length > 0
const printPageCount = 2 + (printHasThemeCards ? 1 : 0) + printSectionsNormal.length
let printPageCursor = 0
const nextPrintPage = () => {
  printPageCursor += 1
  return printPageCursor
}
const printCoverPage = nextPrintPage()
const printContentsPage = nextPrintPage()
const printThemeCardsPage = printHasThemeCards ? nextPrintPage() : 0
const printSectionPages = printSectionsNormal.map(() => nextPrintPage())
const themeCardsHref = printHasThemeCards ? '#print-themes-cards' : undefined

const printSectionKeyOcc = new Map<string, number>()
const printSectionSheetIds = printSectionsNormal.map((page) => {
  const key = page.section.key
  const n = (printSectionKeyOcc.get(key) || 0) + 1
  printSectionKeyOcc.set(key, n)
  return `print-${key}-${n}`
})

/** News river: keep full magazine order (01–07), including empty “no update” sections. */
const newsChapterSource = printSections

const newsKeyOcc = new Map<string, number>()
const newsChapters = newsChapterSource.map((page, index) => {
  const key = page.section.key
  const occ = (newsKeyOcc.get(key) || 0) + 1
  newsKeyOcc.set(key, occ)
  const pdf = PDF_SECTION_TITLES[key as keyof typeof PDF_SECTION_TITLES]
  const sectionTitle = pdf
    ? lang === 'te'
      ? pdf.te
      : pdf.en
    : page.pageLabel
  return {
    id: `nr-${key}-${occ}`,
    key,
    occ,
    num: pdf?.num || String(index + 1).padStart(2, '0'),
    sectionTitle,
    heading: page.heading || '',
    blurb: pdf ? (lang === 'te' ? pdf.blurbTe : pdf.blurbEn) : '',
    bodyHtml: page.bodyHtml,
    emptyBody: page.emptyBody,
    hasShortItems: page.hasShortItems,
    images: page.images.filter(Boolean) as {
      src: string
      caption?: string | null
      alt: string
    }[],
    section: page.section,
  }
})

const newsToc = [
  {
    id: 'nr-cover',
    num: '00',
    label: lang === 'te' ? 'ముఖచిత్రం' : 'Cover',
  },
  ...newsChapters.map((ch) => {
    const totalForKey = newsKeyOcc.get(ch.key) || 1
    const label =
      totalForKey > 1 ? `${ch.sectionTitle} (${ch.occ})` : ch.sectionTitle
    return {
      id: ch.id,
      num: ch.num,
      label,
    }
  }),
]
---

{
  view === 'print' ? (
    <BaseLayout title={`${title} · QLU`} lang={lang} variant="print" mainClass="print-main">
      {error ? (
        <p class="qlu-error">{error}</p>
      ) : issue ? (
        <>
        <div class="print-desk">
          <div class="print-toolbar">
            <div class="view-switch" role="navigation" aria-label={labelLayout}>
              <a class:list={['view-switch-btn', view === 'flip' && 'is-active']} href={flipHref}>
                {labelFlip}
              </a>
              <a class:list={['view-switch-btn', view === 'news' && 'is-active']} href={newsHref}>
                {labelNews}
              </a>
              <a class:list={['view-switch-btn', view === 'print' && 'is-active']} href={printHref}>
                {labelPrint}
              </a>
            </div>
            <div class="qlu-lang" role="navigation" aria-label="Language">
              <a class:list={{ active: lang === 'te' }} href={printHrefTe}>
                TE
              </a>
              <a class:list={{ active: lang === 'en' }} href={printHrefEn}>
                EN
              </a>
            </div>
            <a class="flip-archive" href="/issues/">
              {lang === 'te' ? 'అన్ని సంచికలు' : 'All issues'}
            </a>
          </div>

          <PrintCover
            issue={issue}
            lang={lang}
            title={title}
            mastheadHtml={mastheadHtml}
            page={printCoverPage}
            pages={printPageCount}
          />
          <PrintContents
            lang={lang}
            month={issue.month}
            presentKeys={printPresentKeys}
            page={printContentsPage}
            pages={printPageCount}
            themeCardsHref={themeCardsHref}
          />
          {printHasThemeCards ? (
            <PrintThemeCards
              cards={printThemeCards}
              lang={lang}
              month={issue.month}
              year={printYear}
              page={printThemeCardsPage}
              pages={printPageCount}
            />
          ) : null}
          {printSectionsNormal.map((page, entryIndex) => (
            <PrintSection
              section={page.section}
              lang={lang}
              bodyHtml={page.bodyHtml}
              month={issue.month}
              year={printYear}
              entryIndex={entryIndex}
              sheetId={printSectionSheetIds[entryIndex]}
              page={printSectionPages[entryIndex]!}
              pages={printPageCount}
            />
          ))}
        </div>
        <BirthdaySplash lang={lang} />
        </>
      ) : null}
    </BaseLayout>
  ) : view === 'news' ? (
    <BaseLayout title={`${title} · QLU`} lang={lang} variant="news" mainClass="news-main">
      {error ? (
        <p class="qlu-error">{error}</p>
      ) : issue ? (
        <>
          <NewsRiver
            issue={issue}
            lang={lang}
            title={title}
            mastheadHtml={mastheadHtml}
            chapters={newsChapters}
            toc={newsToc}
            newsHrefTe={newsHrefTe}
            newsHrefEn={newsHrefEn}
          />
          <BirthdaySplash lang={lang} />
        </>
      ) : null}
    </BaseLayout>
  ) : (
    <BaseLayout title={`${title} · QLU`} lang={lang} variant="reader" mainClass="flip-main">
      {error ? (
        <p class="qlu-error">{error}</p>
      ) : issue ? (
        <>
        <div class="flip-desk" data-flipbook>
          <div class="flip-meta">
            <div class="flip-meta-text">
              <p class="flip-kicker">Monthly newsletter · {issue.month}</p>
              <h1 class="flip-title">{title}</h1>
            </div>
            <div class="flip-meta-actions">
              <div class="view-switch" role="navigation" aria-label={labelLayout}>
                <a class:list={['view-switch-btn', view === 'flip' && 'is-active']} href={flipHref}>
                  {labelFlip}
                </a>
                <a class:list={['view-switch-btn', view === 'news' && 'is-active']} href={newsHref}>
                  {labelNews}
                </a>
                <a class:list={['view-switch-btn', view === 'print' && 'is-active']} href={printHref}>
                  {labelPrint}
                </a>
              </div>
              <div class="qlu-lang" role="navigation" aria-label="Language">
                <a class:list={{ active: lang === 'te' }} href={flipHrefTe}>
                  TE
                </a>
                <a class:list={{ active: lang === 'en' }} href={flipHrefEn}>
                  EN
                </a>
              </div>
              <a class="flip-archive" href="/issues/">
                All issues
              </a>
            </div>
          </div>

          <nav class="flip-chips" aria-label={lang === 'te' ? 'విభాగాలు' : 'Sections'}>
            {pages.map((page, i) => (
              <button
                type="button"
                class:list={['flip-chip', i === 0 && 'is-active']}
                data-flip-goto={i}
                title={page.pageLabel}
                aria-label={page.pageLabel}
              >
                <span class="flip-chip-num">{i + 1}</span>
                <span class="flip-chip-text">{page.chipLabel}</span>
              </button>
            ))}
          </nav>

          <div class="flip-shell" aria-live="polite">
            <button type="button" class="flip-edge flip-edge--prev" data-flip-prev aria-label="Previous page">
              ‹
            </button>

            <div class="flip-stage" data-flip-stage>
              <div class="flip-book">
                <div class="flip-spine" aria-hidden="true" />
                {pages.map((page, i) => (
                  <article
                    class:list={[
                      'flip-page',
                      page.isCover && 'is-cover',
                      i === 0 && 'is-current',
                    ]}
                    data-flip-page
                    data-key={page.section.key}
                  >
                    <div class="flip-page-inner">
                      <header class="flip-page-head">
                        <span class="flip-page-section">{page.pageLabel}</span>
                        <span class="flip-page-issue">{issue.month}</span>
                      </header>

                      {page.isCover ? (
                        <div class="flip-cover">
                          <p class="flip-cover-brand">Quantum Life University</p>
                          <h2 class="flip-cover-title">{title}</h2>
                          {page.images.length ? (
                            <div class="flip-figures">
                              {page.images.map((img) =>
                                img ? (
                                  <figure class:list={[`align-${img.align}`, `size-${img.size}`]}>
                                    <img src={img.src} alt={img.alt || ''} loading="lazy" />
                                    {img.caption ? <figcaption>{img.caption}</figcaption> : null}
                                  </figure>
                                ) : null,
                              )}
                            </div>
                          ) : null}
                          {!page.emptyBody ? (
                            <div class="qlu-prose flip-prose flip-cover-lede" set:html={page.bodyHtml} />
                          ) : null}
                        </div>
                      ) : (
                        <>
                          {page.heading ? <h2 class="flip-section-title">{page.heading}</h2> : null}
                          {page.images.length ? (
                            <div class="flip-figures">
                              {page.images.map((img) =>
                                img ? (
                                  <figure class:list={[`align-${img.align}`, `size-${img.size}`]}>
                                    <img src={img.src} alt={img.alt || ''} loading="lazy" />
                                    {img.caption ? <figcaption>{img.caption}</figcaption> : null}
                                  </figure>
                                ) : null,
                              )}
                            </div>
                          ) : null}
                          {!page.emptyBody ? (
                            <div class="qlu-prose flip-prose" set:html={page.bodyHtml} />
                          ) : null}
                          {page.hasShortItems ? (
                            <ShortItems section={page.section} lang={lang} month={month!} from="flip" />
                          ) : null}
                        </>
                      )}

                      <footer class="flip-page-foot">QLU · {issue.month}</footer>
                    </div>
                  </article>
                ))}
              </div>
            </div>

            <button type="button" class="flip-edge flip-edge--next" data-flip-next aria-label="Next page">
              ›
            </button>
          </div>

          <div class="flip-controls">
            <button type="button" class="flip-btn" data-flip-prev>
              {lang === 'te' ? '← వెనుక' : '← Back'}
            </button>
            <div class="flip-pager">
              <span class="flip-label" data-flip-label>
                1 / {pages.length}
              </span>
              <div class="flip-dots" data-flip-dots />
            </div>
            <button type="button" class="flip-btn" data-flip-next>
              {lang === 'te' ? 'ముందు →' : 'Forward →'}
            </button>
          </div>

          <p class="flip-hint">
            {lang === 'te'
              ? 'అంచులను నొక్కండి · ← → కీలు · స్వైప్'
              : 'Click page edges · ← → keys · swipe'}
            {' · '}
            <a href={flipHrefOther}>{other === 'te' ? 'తెలుగు' : 'English'}</a>
          </p>
        </div>
        <BirthdaySplash lang={lang} />
        </>
      ) : null}
    </BaseLayout>
  )
}

<script>
  import { initFlipbook } from '../../../scripts/flipbook'
  import { initNewsView } from '../../../scripts/newsview'
  import { initBirthdaySplash } from '../../../scripts/birthdaySplash'
  import { initCardMasonry } from '../../../scripts/cardMasonry'

  document.querySelectorAll<HTMLElement>('[data-flipbook]').forEach((el) => {
    initFlipbook(el)
  })
  document.querySelectorAll<HTMLElement>('[data-newsview]').forEach((el) => {
    initNewsView(el)
  })
  document.querySelectorAll<HTMLElement>('[data-birthday-splash]').forEach((el) => {
    initBirthdaySplash(el)
  })
  initCardMasonry()
</script>
