---
export const prerender = false

import BaseLayout from '../../../../../../../layouts/BaseLayout.astro'
import { mdToHtml } from '../../../../../../../lib/markdown'
import {
  PDF_SECTION_TITLES,
  type SectionKey,
} from '../../../../../../../lib/magazineSections'
import { getIssue, type Lang } from '../../../../../../../lib/payload'
import { qluIssueStamp } from '../../../../../../../lib/printBrand'
import {
  findFullStory,
  newsletterReturnHref,
  storyBackLabel,
} from '../../../../../../../lib/storyLink'

const { month, lang: langParam, section: sectionParam, item: itemParam } = Astro.params
const lang = (langParam === 'te' ? 'te' : 'en') as Lang
const sectionKey = decodeURIComponent(sectionParam || '')
const itemKey = decodeURIComponent(itemParam || '')

if (langParam !== 'te' && langParam !== 'en') {
  return Astro.redirect(
    `/issues/${month}/en/story/${encodeURIComponent(sectionKey)}/${encodeURIComponent(itemKey)}/`,
  )
}

const from = Astro.url.searchParams.get('from')
const returnView = from === 'print' || from === 'flip' ? from : 'news'
const fromQuery = from === 'print' || from === 'flip' ? `?from=${from}` : ''

let issue: Awaited<ReturnType<typeof getIssue>> = null
let error = ''
try {
  issue = await getIssue(month!)
} catch (e) {
  error = e instanceof Error ? e.message : 'CMS error'
}

if (!error && !issue) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const story = issue ? findFullStory(issue, sectionKey, itemKey, lang) : null
if (!error && !story) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const title =
  story?.title ||
  story?.blurb.split(/\n+/).map((l) => l.trim()).find(Boolean) ||
  story?.fullStory.split(/\n+/).map((l) => l.trim()).find(Boolean) ||
  (lang === 'te' ? 'ఇంకా చదవండి' : 'Full story')
const bodyHtml = mdToHtml(story?.fullStory || '')
const blurbText = (story?.blurb || '').trim()
const fullText = (story?.fullStory || '').trim()
const showBlurb = Boolean(blurbText) && blurbText !== fullText
const blurbHtml = showBlurb ? mdToHtml(blurbText) : ''
const issueTitle = issue ? (lang === 'te' ? issue.titleTe : issue.titleEn) : month!
const backHref = newsletterReturnHref(month!, lang, sectionKey, itemKey, returnView)
const teHref = `/issues/${month}/te/story/${encodeURIComponent(sectionKey)}/${encodeURIComponent(itemKey)}/${fromQuery}`
const enHref = `/issues/${month}/en/story/${encodeURIComponent(sectionKey)}/${encodeURIComponent(itemKey)}/${fromQuery}`

const sectionMeta = PDF_SECTION_TITLES[sectionKey as SectionKey]
const sectionNum = sectionMeta?.num || ''
const sectionLabel = sectionMeta
  ? lang === 'te'
    ? sectionMeta.te
    : sectionMeta.en
  : sectionKey
const readMoreLabel = lang === 'te' ? 'పూర్తి కథనం' : 'Full story'
const viewingLabel = lang === 'te' ? 'చూస్తున్నది' : 'Viewing'
const monthLabel = qluIssueStamp(issue?.month || month!, lang)
const chromeTitle = [sectionNum, sectionLabel].filter(Boolean).join(' · ') || readMoreLabel
---

<BaseLayout title={`${title} · ${issueTitle}`} lang={lang} variant="news" mainClass="news-main">
  {
    error ? (
      <p class="qlu-error">{error}</p>
    ) : story ? (
      <div class="nr nr--story" data-storyview>
        <header class="nr__chrome">
          <div class="nr__chrome-left">
            <a class="nr__chrome-brand" href="/">
              <img src="/qlu-logo.png" width="28" height="28" alt="" />
              <span class="nr__chrome-brand-text">QLU</span>
            </a>
            <div class="nr__chrome-issue">
              <span class="nr__chrome-month">{monthLabel}</span>
              <span class="nr__chrome-dot" aria-hidden="true">·</span>
              <span class="nr__chrome-title">{issueTitle}</span>
            </div>
          </div>

          <div class="nr__chrome-center">
            <span class="nr__chrome-viewing-label">{viewingLabel}</span>
            <span class="nr__chrome-viewing" title={title}>{chromeTitle}</span>
            <span class="nr__chrome-story-title" title={title}>{title}</span>
          </div>

          <div class="nr__chrome-right">
            <div class="nr__lang nr__lang--bar" role="navigation" aria-label="Language">
              <a class:list={{ active: lang === 'te' }} href={teHref}>TE</a>
              <a class:list={{ active: lang === 'en' }} href={enHref}>EN</a>
            </div>
            <a class="nr__issues nr__chrome-back" href={backHref}>
              {lang === 'te' ? '← తిరిగి' : '← Back'}
            </a>
            <a class="nr__issues" href="/issues/">
              {lang === 'te' ? 'సంచికలు' : 'Issues'}
            </a>
          </div>
        </header>

        <div class="nr__main">
          <div class="nr__progress" aria-hidden="true">
            <div class="nr__progress-bar" data-story-progress />
          </div>

          <div class="nr__scroll" data-story-scroll>
            <article class="story-reader">
              <div class="story-reader__content">
                {
                  (() => {
                    const gallery =
                      story.imageSrcs?.length
                        ? story.imageSrcs
                        : story.imageSrc
                          ? [{ src: story.imageSrc, alt: story.imageAlt || '' }]
                          : []
                    if (!gallery.length) return null
                    return (
                      <div
                        class:list={[
                          'story-reader__gallery',
                          gallery.length > 1 && 'story-reader__gallery--multi',
                        ]}
                      >
                        {gallery.map((img, i) => (
                          <figure class:list={['story-reader__hero', i > 0 && 'story-reader__hero--extra']}>
                            <img
                              src={img.src}
                              alt={img.alt || title || ''}
                              loading={i === 0 ? 'eager' : 'lazy'}
                              decoding="async"
                            />
                          </figure>
                        ))}
                      </div>
                    )
                  })()
                }

                <div class="story-reader__copy">
                  <p class="story-reader__kicker">
                    {sectionNum ? `${sectionNum} · ` : ''}
                    {sectionLabel}
                    {' · '}
                    {readMoreLabel}
                  </p>
                  {title ? <h1 class="story-reader__title">{title}</h1> : null}
                  {story.meta ? <p class="story-reader__meta">{story.meta}</p> : null}
                  {
                    blurbHtml ? (
                      <div class="story-reader__lede nr-prose" set:html={blurbHtml} />
                    ) : null
                  }
                  {
                    bodyHtml ? (
                      <div class="story-reader__body nr-prose" set:html={bodyHtml} />
                    ) : null
                  }
                  <p class="story-reader__back">
                    <a href={backHref}>{storyBackLabel(lang)}</a>
                  </p>
                </div>
              </div>
            </article>

            <footer class="nr__foot">
              <p>© {new Date().getFullYear()} Quantum Life University</p>
              <p>
                <a href={backHref}>{storyBackLabel(lang)}</a>
                {' · '}
                <a href="/issues/">{lang === 'te' ? 'అన్ని సంచికలు' : 'All issues'}</a>
              </p>
            </footer>
          </div>
        </div>
      </div>
    ) : null
  }
</BaseLayout>

<script>
  import { initStoryView } from '../../../../../../../scripts/storyview'

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('[data-storyview]').forEach((el) => {
      initStoryView(el)
    })
  })
</script>
